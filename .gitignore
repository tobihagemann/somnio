# VS Code
.vscode/

# macOS
.DS_Store
._*

# Test credentials
.env.test

# Sector staging directory the docker-compose example mounts, seeded from the bundled fixtures by
# the docker-smoke and wire-conformance jobs (and by hand for a local conformance run).
# Anchored: an unanchored `sectors/` also matches `packages/server/src/sectors/` and the
# committed fixtures under `packages/core/fixtures/sectors/`.
/sectors/

# Asset-pack checkout the web image's build context expects (CI clones somnio-assets here; a
# local build creates it empty). Never carries art in this repo.
/assets/

# npm workspace artifacts. The root `package-lock.json` IS committed — CI installs with
# `npm ci`, which requires it.
node_modules/
packages/web/dist/
packages/web/.vite/
packages/web/public/assets/

# The server's rotating log files (`logs/gameplay-log.log`, `logs/admin-log.log`).
/logs/
