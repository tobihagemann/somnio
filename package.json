{
  "name": "somnio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Somnio: a browser-based mini-MMORPG with a 3D world. TypeScript server, admin CLI, and Three.js browser client in one npm workspace.",
  "engines": {
    "node": ">=24.17.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,blue \"SOMNIO_DEV_DEFAULTS=1 node packages/server/src/main.ts\" \"npm run dev --workspace packages/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "SOMNIO_INTEGRATION=1 vitest run --project data-integration --project server-integration",
    "conformance": "npm run conformance --workspace packages/web",
    "build": "npm run build --workspace packages/web",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "^10.0.7",
    "eslint": "10.14.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,html}": "prettier --write"
  }
}
