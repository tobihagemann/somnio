{
  "name": "somnio-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser client for Somnio: Three.js world renderer over the shared JSON WebSocket protocol.",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "vite",
    "editor": "SOMNIO_EDITOR_SECTORS_DIR=${SOMNIO_EDITOR_SECTORS_DIR:-$PWD/../sectors} vite --open /editor.html",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "vitest run --config vitest.conformance.config.ts"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.1",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  }
}
